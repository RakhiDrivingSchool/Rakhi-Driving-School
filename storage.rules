rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "replace-with-your-admin-email@example.com"
        && request.resource != null
        && request.resource.size <= 52428800
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'video/mp4'
            || request.resource.contentType == 'video/webm'
            || request.resource.contentType == 'video/quicktime');
      allow delete: if request.auth != null
        && request.auth.token.email == "replace-with-your-admin-email@example.com";
    }
  }
}
